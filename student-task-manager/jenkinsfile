pipeline {

    agent any

    environment {
        DOCKER_USER = "sani642"

        BACKEND_IMAGE = "sani642/student-task-backend"
        FRONTEND_IMAGE = "sani642/student-task-frontend"
    }

    stages {

        stage("Checkout") {
            steps {
                checkout scm
            }
        }

        stage("Docker Login") {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "docker-project-1-cred",
                        usernameVariable: "DOCKER_USERNAME",
                        passwordVariable: "DOCKER_PASSWORD"
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login \
                        -u "$DOCKER_USERNAME" \
                        --password-stdin
                    '''
                }
            }
        }

        stage("Build Backend") {
            steps {
                sh '''
                    docker build \
                    -t ${BACKEND_IMAGE}:latest \
                    ./student-task-manager/backend
                '''
            }
        }

        stage("Build Frontend") {
            steps {
                sh '''
                    docker build \
                    -t ${FRONTEND_IMAGE}:latest \
                    ./student-task-manager/frontend
                '''
            }
        }

        stage("Push Images") {
            steps {
                sh '''
                    docker push ${BACKEND_IMAGE}:latest
                    docker push ${FRONTEND_IMAGE}:latest
                '''
            }
        }
    }

    post {

        success {
            echo "Docker images built and pushed successfully!"
        }

        failure {
            echo "Pipeline failed!"
        }

        always {
            sh '''
                docker logout || true
            '''
        }
    }
}